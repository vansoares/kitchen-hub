# Copie para ".env" nesta mesma pasta (backend/) e preencha com suas credenciais.
# Nunca commite o .env de verdade.

# Exemplo pra Gmail: gere uma "senha de app" em https://myaccount.google.com/apppasswords
# (precisa ter verificacao em duas etapas ativada na conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Opcional: remetente exibido (default = SMTP_USER)
EMAIL_FROM=seuemail@gmail.com

# Para onde a lista de compras e enviada (default = SMTP_USER)
SHOPPING_LIST_TO=seuemail@gmail.com
