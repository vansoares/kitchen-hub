# Copie para ".env.local" (dev) ou configure como variaveis de ambiente no
# projeto Vercel (producao). Nunca commite o arquivo preenchido de verdade.

# --- Banco (Neon / Vercel Postgres) ---
# Use a connection string "pooled" (para funcoes serverless).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"

# --- NextAuth ---
# Gere um valor aleatorio: `openssl rand -base64 32`
NEXTAUTH_SECRET="cole-um-valor-aleatorio-aqui"
# Em producao, a URL publica do seu deploy (ex: https://kitchenhub.vercel.app).
# Em dev local, pode deixar http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# --- Login com Google ---
# Crie em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Por padrao qualquer conta Google consegue logar - cada uma ganha sua
# propria despensa automaticamente e pode compartilha-la com outras contas
# depois, em Configuracoes. Se um dia quiser voltar a restringir o login a
# emails especificos, defina essa variavel (separada por virgula):
# ALLOWED_EMAILS="voce@gmail.com,outra@gmail.com"

# --- Painel de admin ---
# Emails que enxergam a tela /admin e podem liberar features novas pra
# outras contas (separado por virgula). So quem estiver aqui ve o link.
ADMIN_EMAILS="voce@gmail.com"
