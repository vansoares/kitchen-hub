// KitchenHub - modelo de dados da despensa.
// DATABASE_URL deve ser a connection string "pooled" do Neon/Vercel Postgres
// (funcoes serverless abrem/fecham conexao a cada invocacao).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id               Int      @id @default(autoincrement())
  // dono do item - cada login (conta Google) so ve e mexe na propria despensa.
  // default aponta pro email do dono original, so pra popular os dados ja
  // existentes na primeira migracao; todo código novo sempre passa o valor
  // explicitamente.
  userEmail        String   @default("vanessa.ssoares.vs@gmail.com")
  name             String
  quantity         Float    @default(0)
  unit             String   @default("un")
  // divisao de alto nivel da despensa - "category" continua livre e granular
  // (ex: "Laticinios", "Limpeza"), "group" e so essas duas grandes abas.
  group            String   @default("alimento") // "alimento" | "limpeza_higiene"
  category         String   @default("Outros")
  minQuantity      Float    @default(1)
  lastPurchaseDate DateTime? @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  logs ConsumptionLog[]

  @@index([userEmail])
  @@index([name])
  @@index([category])
  @@index([group])
}

// Todo evento que muda o estoque (criacao, compra, consumo, ajuste) fica
// registrado aqui - e a base do historico de consumo.
model ConsumptionLog {
  id            Int      @id @default(autoincrement())
  itemId        Int?
  item          Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName      String // denormalizado: historico sobrevive a exclusao do item
  change        Float // positivo = entrada de estoque, negativo = consumo
  quantityAfter Float
  reason        String // "compra" | "consumo" | "ajuste" | "criacao"
  timestamp     DateTime @default(now())

  @@index([timestamp])
  @@index([itemId])
}

model Recipe {
  id           Int      @id @default(autoincrement())
  userEmail    String   @default("vanessa.ssoares.vs@gmail.com")
  title        String
  servings     Int      @default(1)
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients RecipeIngredient[]

  @@index([userEmail])
  @@index([title])
}

// Ingrediente e texto livre (nao aponta pro Item da despensa) - uma receita
// pode citar "alho" mesmo que a despensa nao controle alho como item.
model RecipeIngredient {
  id       Int    @id @default(autoincrement())
  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity Float
  unit     String @default("un")

  @@index([recipeId])
}

// Valor gasto registrado ao final de uma ida ao mercado (lista de compras),
// pra alimentar o balanco de gastos.
model Purchase {
  id        Int      @id @default(autoincrement())
  userEmail String   @default("vanessa.ssoares.vs@gmail.com")
  total     Float
  note      String?
  createdAt DateTime @default(now())

  @@index([userEmail])
  @@index([createdAt])
}
