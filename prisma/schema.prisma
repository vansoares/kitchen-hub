// KitchenHub - modelo de dados da despensa.
// DATABASE_URL deve ser a connection string "pooled" do Neon/Vercel Postgres
// (funcoes serverless abrem/fecham conexao a cada invocacao).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Uma "casa" - dono da despensa, receitas e compras. Cada email logado
// pertence a exatamente um household (ver HouseholdMember); pessoas que
// moram juntas entram no mesmo household pra compartilhar tudo.
model Household {
  id        Int      @id @default(autoincrement())
  name      String   @default("Minha despensa")
  createdAt DateTime @default(now())

  members       HouseholdMember[]
  items         Item[]
  recipes       Recipe[]
  purchases     Purchase[]
  shoppingLists ShoppingList[]
}

// Liga um email (login) a um household. Unico por email: uma pessoa so
// pode estar em uma casa por vez.
model HouseholdMember {
  id          Int       @id @default(autoincrement())
  userEmail   String    @unique
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

model Item {
  id               Int      @id @default(autoincrement())
  // dono do item - toda a casa (household) ve e mexe na mesma despensa.
  householdId      Int
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name             String
  quantity         Float    @default(0)
  unit             String   @default("un")
  // divisao de alto nivel da despensa - "category" continua livre e granular
  // (ex: "Laticinios", "Limpeza"), "group" e so essas duas grandes abas.
  group            String   @default("alimento") // "alimento" | "limpeza_higiene"
  category         String   @default("Outros")
  minQuantity      Float    @default(1)
  lastPurchaseDate DateTime? @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  logs             ConsumptionLog[]
  shoppingListRefs ShoppingListItem[]

  @@index([householdId])
  @@index([name])
  @@index([category])
  @@index([group])
}

// Todo evento que muda o estoque (criacao, compra, consumo, ajuste) fica
// registrado aqui - e a base do historico de consumo.
model ConsumptionLog {
  id            Int      @id @default(autoincrement())
  itemId        Int?
  item          Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName      String // denormalizado: historico sobrevive a exclusao do item
  change        Float // positivo = entrada de estoque, negativo = consumo
  quantityAfter Float
  reason        String // "compra" | "consumo" | "ajuste" | "criacao"
  timestamp     DateTime @default(now())

  @@index([timestamp])
  @@index([itemId])
}

model Recipe {
  id           Int      @id @default(autoincrement())
  householdId  Int
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title        String
  servings     Int      @default(1)
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients RecipeIngredient[]

  @@index([householdId])
  @@index([title])
}

// Ingrediente e texto livre (nao aponta pro Item da despensa) - uma receita
// pode citar "alho" mesmo que a despensa nao controle alho como item.
model RecipeIngredient {
  id       Int    @id @default(autoincrement())
  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity Float
  unit     String @default("un")

  @@index([recipeId])
}

// Valor gasto registrado ao final de uma ida ao mercado (lista de compras),
// pra alimentar o balanco de gastos.
model Purchase {
  id          Int      @id @default(autoincrement())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  total       Float
  note        String?
  createdAt   DateTime @default(now())

  @@index([householdId])
  @@index([createdAt])
}

// Todo email que ja logou no app pelo menos uma vez - alimenta a tela de
// admin ("todas as pessoas com conta criada"). Atualizado a cada login.
model AppUser {
  email       String   @id
  name        String?
  image       String?
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())
}

// Libera uma funcionalidade (ver src/lib/features.ts) pra um email
// especifico. A existencia da linha = liberado; sem linha = bloqueado.
// So o admin (ver src/lib/admin.ts) mexe aqui.
model FeatureGrant {
  id        Int      @id @default(autoincrement())
  userEmail String
  feature   String
  createdAt DateTime @default(now())

  @@unique([userEmail, feature])
  @@index([userEmail])
}

// Lista de compras "do zero" - separada do checklist automatico (que usa
// os itens abaixo do minimo). Presa ao household, entao todo mundo que
// compartilha a despensa compartilha a mesma lista.
model ShoppingList {
  id          Int      @id @default(autoincrement())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ShoppingListItem[]

  @@index([householdId])
}

model ShoppingListItem {
  id        Int      @id @default(autoincrement())
  listId    Int
  list      ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  // opcional: quando a pessoa escolhe um item ja cadastrado na despensa em
  // vez de digitar um nome livre. Sobrevive a exclusao do item (SetNull).
  itemId    Int?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name      String
  quantity  Float    @default(1)
  unit      String   @default("un")
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([listId])
}
